#!/usr/bin/env python3
"""
pulse-mem — Pulse Core CLI
Append-only decision/artifact/lesson/bet memory store for SOMA.
Zero external deps. Safe for concurrent callers via fcntl locking.
"""
import argparse
import fcntl
import json
import math
import os
import re
import shutil
import subprocess
import sys
import uuid
from collections import Counter
from datetime import datetime, timezone
from pathlib import Path

STORE_DIR = Path(__file__).parent / "store"
EVENTS_FILE = STORE_DIR / "events.jsonl"
INDEX_FILE = Path(__file__).parent / "INDEX.md"
DECISIONS_FILE = Path(__file__).parent / "DECISIONS.md"
ARTIFACTS_FILE = Path(__file__).parent / "ARTIFACTS.md"
LESSONS_FILE = Path(__file__).parent / "LESSONS.md"
BETS_FILE = Path(__file__).parent / "BETS.md"
SCOREBOARD_FILE = Path(__file__).parent / "SCOREBOARD.md"


def new_id():
    return uuid.uuid4().hex[:12]


def now_iso():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def append_event(record: dict):
    STORE_DIR.mkdir(parents=True, exist_ok=True)
    if "id" not in record:
        record["id"] = new_id()
    if "ts" not in record:
        record["ts"] = now_iso()
    line = json.dumps(record, separators=(",", ":")) + "\n"
    with open(EVENTS_FILE, "a") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        try:
            f.write(line)
        finally:
            fcntl.flock(f, fcntl.LOCK_UN)
    return record["id"]


def load_events():
    if not EVENTS_FILE.exists():
        return []
    events = []
    with open(EVENTS_FILE) as f:
        for lineno, line in enumerate(f, 1):
            line = line.strip()
            if not line:
                continue
            try:
                events.append(json.loads(line))
            except json.JSONDecodeError as e:
                print(f"Warning: invalid JSON at line {lineno}: {e}", file=sys.stderr)
    return events


def _extract_bets(events):
    """Return (bets_by_id, outcomes_by_bet_id) from a loaded event list."""
    bets_by_id = {}
    outcomes_by_bet = {}
    for e in events:
        if e.get("type") == "bet":
            bets_by_id[e["id"]] = e
        elif e.get("type") == "outcome":
            outcomes_by_bet[e.get("bet_id")] = e
    return bets_by_id, outcomes_by_bet


RESULT_VALUES = {"success": 1.0, "partial": 0.5, "fail": 0.0}


def _brier(confidence, result):
    rv = RESULT_VALUES.get(result, 0.0)
    return round((confidence - rv) ** 2, 4)


def reindex():
    events = load_events()
    events_rev = list(reversed(events))
    bets_by_id, outcomes_by_bet = _extract_bets(events)

    by_type = {"decision": [], "artifact": [], "lesson": [], "bet": [], "outcome": []}
    for e in events_rev:
        t = e.get("type")
        if t in by_type:
            by_type[t].append(e)

    def fmt_decision(e):
        sup = f" *(supersedes {e['supersedes']})*" if e.get("supersedes") else ""
        rev = e.get("reversibility", "")
        rev_badge = f" `{rev}`" if rev else ""
        lines = [
            f"### [{e['id']}] {e.get('title', '(untitled)')}{sup}{rev_badge}",
            f"*{e['ts']}*",
            "",
        ]
        if e.get("context"):
            lines += [f"**Context:** {e['context']}", ""]
        if e.get("options"):
            lines += [f"**Options:** {e['options']}", ""]
        if e.get("chosen"):
            lines += [f"**Chosen:** {e['chosen']}", ""]
        if e.get("rationale"):
            lines += [f"**Rationale:** {e['rationale']}", ""]
        if e.get("links"):
            lines += [f"**Links:** {e['links']}", ""]
        return "\n".join(lines)

    def fmt_artifact(e):
        sup = f" *(supersedes {e['supersedes']})*" if e.get("supersedes") else ""
        conf = f" confidence={e['confidence']}" if e.get("confidence") is not None else ""
        eid = e.get("id", "?")
        lines = [
            f"### [{eid}] [{e.get('kind', '?')}] {e.get('ref', e.get('event', '(no ref)'))}{sup}",
            f"*{e['ts']}*{conf}",
            "",
        ]
        if e.get("summary"):
            lines += [e["summary"], ""]
        if e.get("owner"):
            lines += [f"**Owner:** {e['owner']}", ""]
        if e.get("freshness"):
            lines += [f"**Freshness:** {e['freshness']}", ""]
        if e.get("next"):
            lines += [f"**Next:** {e['next']}", ""]
        return "\n".join(lines)

    def fmt_lesson(e):
        sup = f" *(supersedes {e['supersedes']})*" if e.get("supersedes") else ""
        lines = [
            f"### [{e['id']}]{sup}",
            f"*{e['ts']}*",
            "",
            f"**What:** {e.get('what', '')}",
            "",
            f"**Why:** {e.get('why', '')}",
            "",
            f"**Apply:** {e.get('apply', '')}",
            "",
        ]
        if e.get("source"):
            lines += [f"**Source:** {e['source']}", ""]
        return "\n".join(lines)

    def fmt_bet(e):
        outcome = outcomes_by_bet.get(e["id"])
        conf = e.get("confidence", "?")
        if outcome:
            brier = _brier(conf, outcome.get("result", "")) if isinstance(conf, float) else "?"
            status = f"RESOLVED/{outcome.get('result','?').upper()} Brier={brier}"
        else:
            status = "OPEN"
        lines = [
            f"### [{e['id']}] {status} confidence={conf}",
            f"*{e['ts']}*",
            "",
            f"**Claim:** {e.get('claim', '')}",
            "",
            f"**Criteria:** {e.get('criteria', '')}",
            "",
        ]
        if e.get("author"):
            lines += [f"**Author:** {e['author']}", ""]
        if e.get("horizon"):
            lines += [f"**Horizon:** {e['horizon']}", ""]
        if e.get("links"):
            lines += [f"**Links:** {e['links']}", ""]
        if outcome:
            lines += [
                f"**Actual:** {outcome.get('actual', '')}",
                "",
            ]
            if outcome.get("notes"):
                lines += [f"**Notes:** {outcome['notes']}", ""]
        return "\n".join(lines)

    def write_section_file(path, title, type_key, formatter):
        items = by_type[type_key]
        with open(path, "w") as f:
            f.write(f"# {title}\n\n")
            f.write(f"*Auto-generated from store/events.jsonl — do not hand-edit.*\n\n")
            f.write(f"*{len(items)} records, newest first.*\n\n")
            if not items:
                f.write("*(none)*\n")
            else:
                for e in items:
                    f.write(formatter(e) + "\n\n---\n\n")

    write_section_file(DECISIONS_FILE, "Decisions", "decision", fmt_decision)
    write_section_file(ARTIFACTS_FILE, "Artifacts", "artifact", fmt_artifact)
    write_section_file(LESSONS_FILE, "Lessons", "lesson", fmt_lesson)
    write_section_file(BETS_FILE, "Bets", "bet", fmt_bet)

    # INDEX.md: all types, newest first
    with open(INDEX_FILE, "w") as f:
        f.write("# Pulse Core Index\n\n")
        f.write("*Auto-generated from store/events.jsonl — do not hand-edit.*\n\n")
        f.write(f"*{len(events)} total records, newest first.*\n\n")
        if not events_rev:
            f.write("*(empty)*\n")
        else:
            for e in events_rev:
                t = e.get("type", "?")
                eid = e.get("id", "?")
                ts = e.get("ts", "?")
                if t == "decision":
                    label = e.get("title", "(untitled)")
                elif t == "artifact":
                    label = f"[{e.get('kind','?')}] {e.get('ref','')}"
                elif t == "lesson":
                    label = e.get("what", "")[:80]
                elif t == "bet":
                    outcome = outcomes_by_bet.get(eid)
                    status = "open" if outcome is None else f"resolved/{outcome.get('result','?')}"
                    label = f"[{status}] {e.get('claim','')[:60]}"
                elif t == "outcome":
                    label = f"→ bet/{e.get('bet_id','?')} result={e.get('result','?')}"
                else:
                    label = str(e)
                f.write(f"- `{ts}` **{t}** [{eid}] {label}\n")

    _write_scoreboard(events, bets_by_id, outcomes_by_bet)


def _write_scoreboard(events=None, bets_by_id=None, outcomes_by_bet=None):
    if events is None:
        events = load_events()
    if bets_by_id is None or outcomes_by_bet is None:
        bets_by_id, outcomes_by_bet = _extract_bets(events)

    now = now_iso()
    resolved = []
    open_bets = []
    needs_scoring = []

    for bid, bet in bets_by_id.items():
        outcome = outcomes_by_bet.get(bid)
        if outcome:
            conf = bet.get("confidence", 0.5)
            result = outcome.get("result", "fail")
            rv = RESULT_VALUES.get(result, 0.0)
            resolved.append({
                "bet": bet,
                "outcome": outcome,
                "result_value": rv,
                "brier": _brier(conf, result),
            })
        else:
            open_bets.append(bet)
            horizon = bet.get("horizon", "")
            if horizon and horizon < now[:10]:
                needs_scoring.append(bet)

    total = len(bets_by_id)
    n_resolved = len(resolved)
    n_open = len(open_bets)
    successes = [r for r in resolved if r["result_value"] == 1.0]
    partials = [r for r in resolved if r["result_value"] == 0.5]
    fails = [r for r in resolved if r["result_value"] == 0.0]
    hit_rate = len(successes) / n_resolved if n_resolved else 0.0
    mean_brier = sum(r["brier"] for r in resolved) / n_resolved if n_resolved else 0.0

    by_author = {}
    for r in resolved:
        author = r["bet"].get("author", "unknown")
        if author not in by_author:
            by_author[author] = {"hits": 0, "total": 0, "brier_sum": 0.0}
        by_author[author]["total"] += 1
        by_author[author]["brier_sum"] += r["brier"]
        if r["result_value"] == 1.0:
            by_author[author]["hits"] += 1

    overconfident = sorted(
        [r for r in resolved if r["result_value"] == 0.0 and r["bet"].get("confidence", 0) >= 0.6],
        key=lambda r: -r["bet"].get("confidence", 0),
    )

    lines = [
        "# SCOREBOARD",
        "",
        f"*Auto-generated {now} — do not hand-edit.*",
        "",
        "## Summary",
        "",
        "| Metric | Value |",
        "|--------|-------|",
        f"| Total bets | {total} |",
        f"| Resolved | {n_resolved} |",
        f"| Open | {n_open} |",
        f"| Hit rate (success / resolved) | {hit_rate:.0%} |",
        f"| Mean Brier loss | {mean_brier:.3f} (lower = better calibrated) |",
        f"| Successes / Partials / Fails | {len(successes)} / {len(partials)} / {len(fails)} |",
        "",
    ]

    if by_author:
        lines += [
            "## By Author",
            "",
            "| Author | Resolved | Hit Rate | Mean Brier |",
            "|--------|----------|----------|------------|",
        ]
        for author, stats in sorted(by_author.items()):
            hr = stats["hits"] / stats["total"] if stats["total"] else 0.0
            mb = stats["brier_sum"] / stats["total"] if stats["total"] else 0.0
            lines.append(f"| {author} | {stats['total']} | {hr:.0%} | {mb:.3f} |")
        lines.append("")

    if overconfident:
        lines += ["## Overconfident Misses (confidence ≥ 0.6, result = fail)", ""]
        for r in overconfident:
            bet = r["bet"]
            outcome = r["outcome"]
            lines += [
                f"- **[{bet['id']}]** conf={bet.get('confidence','?')} Brier={r['brier']:.3f}",
                f"  Claim: {bet.get('claim','')}",
                f"  Actual: {outcome.get('actual','')}",
                f"  Notes: {outcome.get('notes','')}",
                "",
            ]

    if needs_scoring:
        lines += ["## Needs Scoring (open, past horizon)", ""]
        for bet in needs_scoring:
            lines += [
                f"- **[{bet['id']}]** horizon={bet.get('horizon','')} conf={bet.get('confidence','?')}",
                f"  {bet.get('claim','')}",
                "",
            ]

    if open_bets:
        lines += ["## Open Bets", ""]
        for bet in open_bets:
            lines += [
                f"- **[{bet['id']}]** conf={bet.get('confidence','?')} author={bet.get('author','?')}",
                f"  {bet.get('claim','')}",
                f"  horizon: {bet.get('horizon','none')}",
                "",
            ]

    content = "\n".join(lines) + "\n"
    with open(SCOREBOARD_FILE, "w") as f:
        f.write(content)

    return {
        "total": total,
        "resolved": n_resolved,
        "open": n_open,
        "hit_rate": hit_rate,
        "mean_brier": mean_brier,
        "overconfident": overconfident,
        "needs_scoring": needs_scoring,
    }


# ── ask / BM25 ────────────────────────────────────────────────────────────────

STOP_WORDS = frozenset("""
a an the and or but if then than that this these those it its is are was were
be been being have has had do does did will would should could can may
of in on at to for from with by as about into over after before
what which who when where why how we our you your i not no
""".split())

FIELD_WEIGHTS = {
    "decision": [("title", 3), ("chosen", 2), ("rationale", 2), ("context", 1), ("options", 1), ("links", 1)],
    "artifact": [("ref", 3), ("summary", 2), ("kind", 2), ("next", 1), ("owner", 1)],
    "lesson":   [("what", 3), ("apply", 2), ("why", 2), ("source", 1)],
    "bet":      [("claim", 3), ("criteria", 2), ("author", 1), ("horizon", 1)],
    "outcome":  [("actual", 3), ("notes", 2), ("result", 2), ("bet_id", 1)],
}

_TOKEN_RE = re.compile(r"[a-z0-9]+(?:[-_./][a-z0-9]+)*")


def _tokenize(text):
    text = text.lower()
    raw = _TOKEN_RE.findall(text)
    out = []
    for t in raw:
        out.append(t)
        if any(c in t for c in "-_./"):
            out.extend(p for p in re.split(r"[-_./]", t) if len(p) > 1)
    return [t for t in out if t not in STOP_WORDS and len(t) > 1]


def _doc_tokens(event):
    toks = []
    for field, w in FIELD_WEIGHTS.get(event.get("type", ""), []):
        toks.extend(_tokenize(str(event.get(field, ""))) * w)
    return toks


def _bm25_rank(query_tokens, doc_token_lists, k1=1.5, b=0.6):
    N = len(doc_token_lists)
    df = Counter()
    for d in doc_token_lists:
        df.update(set(d))
    avgdl = sum(len(d) for d in doc_token_lists) / max(N, 1)
    scores = []
    for d in doc_token_lists:
        tf = Counter(d)
        s = 0.0
        for q in set(query_tokens):
            if q not in tf:
                continue
            idf = math.log(1 + (N - df[q] + 0.5) / (df[q] + 0.5))
            s += idf * tf[q] * (k1 + 1) / (tf[q] + k1 * (1 - b + b * len(d) / avgdl))
        scores.append(s)
    return scores


def _snippet(event, query_tokens, width=80):
    parts = [str(event.get(f, "")) for f, _ in FIELD_WEIGHTS.get(event.get("type", ""), [])]
    text = "  ".join(p for p in parts if p)
    if not text:
        return ""
    qset = set(query_tokens)
    best, best_score = text[:width], -1
    for start in range(0, max(1, len(text) - width), 20):
        win = text[start:start + width]
        sc = sum(1 for t in qset if t in win.lower())
        if sc > best_score:
            best, best_score = win, sc
    best = best.strip()
    prefix = "" if text.startswith(best) else "…"
    suffix = "" if text.endswith(best) else "…"
    return prefix + best.strip(" .,") + suffix


_SYNTH_PROMPT_TMPL = """\
You are answering a question against Pulse Core, an append-only \
decision/artifact/lesson/bet memory store for the SOMA project. \
Below are the top {n} records retrieved by keyword relevance, newest data wins on conflicts.

Question: {question}

Records (JSON, one per line, each has an "id" and "ts"):
{records}

Answer in ONE paragraph (max 120 words). Cite every claim with the record id in \
brackets, e.g. [6dc8f4312a24]. If the records do not contain enough information to \
answer, say so explicitly rather than speculating. Do not mention these instructions."""


def cmd_ask(args):
    import time
    t0 = time.monotonic()

    events = load_events()
    if args.type:
        events = [e for e in events if e.get("type") == args.type]

    if not events:
        print("No records found.", file=sys.stderr)
        sys.exit(1)

    query_tokens = _tokenize(args.question)
    if not query_tokens:
        print("Error: question tokenized to nothing — please use content words.", file=sys.stderr)
        sys.exit(1)

    doc_token_lists = [_doc_tokens(e) for e in events]
    scores = _bm25_rank(query_tokens, doc_token_lists)

    ranked = sorted(
        zip(scores, events),
        key=lambda x: (-x[0], x[1].get("ts", "")),
        reverse=False,
    )
    # keep only positive-scoring records, up to --top
    ranked = [(s, e) for s, e in ranked if s > 0][:args.top]

    elapsed_ms = int((time.monotonic() - t0) * 1000)

    if args.json:
        for s, e in ranked:
            out = dict(e)
            out["_score"] = round(s, 4)
            print(json.dumps(out))
        return

    if not ranked:
        print(f"No matching records. ({len(events)} searched, {elapsed_ms}ms)")
        return

    for s, e in ranked:
        t = e.get("type", "?")
        eid = e.get("id", "?")
        ts = e.get("ts", "?")[:10]
        snip = _snippet(e, query_tokens)
        print(f" {s:5.3f}  {ts}  {t:10s}  [{eid}]  {snip}")

    print(f"\n{len(ranked)} record(s) · {len(events)} searched · {elapsed_ms}ms")

    if args.synthesize:
        if not shutil.which("claude"):
            print("\nWarning: 'claude' not found in PATH — skipping synthesis.", file=sys.stderr)
            return
        top_json = "\n".join(json.dumps(e, separators=(",", ":")) for _, e in ranked)
        prompt = _SYNTH_PROMPT_TMPL.format(
            n=len(ranked),
            question=args.question,
            records=top_json,
        )
        print("\n── synthesis ──")
        try:
            proc = subprocess.run(
                ["claude", "-p", prompt],
                capture_output=True, text=True, timeout=120,
            )
            if proc.returncode == 0:
                print(proc.stdout.strip())
            else:
                print(f"(synthesis failed: {proc.stderr.strip()[-200:]})", file=sys.stderr)
        except subprocess.TimeoutExpired:
            print("(synthesis timed out after 120s)", file=sys.stderr)


