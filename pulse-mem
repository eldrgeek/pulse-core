    eid = append_event(record)
    reindex()
    print(f"bet/{eid}")


def cmd_bet_score(args):
    events = load_events()
    bets_by_id, outcomes_by_bet = _extract_bets(events)

    bet_id = args.bet_id
    if bet_id not in bets_by_id:
        print(f"Error: no bet with id '{bet_id}'", file=sys.stderr)
        sys.exit(1)
    if bet_id in outcomes_by_bet:
        existing = outcomes_by_bet[bet_id]
        print(f"Error: bet/{bet_id} already scored as '{existing.get('result')}' (outcome/{existing['id']})", file=sys.stderr)
        sys.exit(1)

    bet = bets_by_id[bet_id]
    conf = bet.get("confidence", 0.5)
    brier = _brier(conf, args.result)

    record = {
        "type": "outcome",
        "bet_id": bet_id,
        "result": args.result,
        "actual": args.actual,
        "brier": brier,
    }
    if args.notes:
        record["notes"] = args.notes

    oid = append_event(record)
    reindex()
    print(f"outcome/{oid}  bet/{bet_id} → {args.result}  Brier={brier:.4f}")


def cmd_bet_list(args):
    events = load_events()
    bets_by_id, outcomes_by_bet = _extract_bets(events)

    bets = [e for e in reversed(events) if e.get("type") == "bet"]
    if args.open:
        bets = [b for b in bets if b["id"] not in outcomes_by_bet]

    for bet in bets:
        bid = bet["id"]
        outcome = outcomes_by_bet.get(bid)
        conf = bet.get("confidence", "?")
        if outcome:
            status = f"resolved/{outcome.get('result','?')}"
        else:
            status = "open"
        print(f"{bet['ts']}  bet [{bid}] conf={conf} [{status}]")
        print(f"  {bet.get('claim','')}")
    print(f"\n{len(bets)} bet(s)")


def cmd_scoreboard(args):
    stats = _write_scoreboard()
    events = load_events()
    bets_by_id, outcomes_by_bet = _extract_bets(events)

    resolved = []
    for bid, bet in bets_by_id.items():
        outcome = outcomes_by_bet.get(bid)
        if outcome:
            conf = bet.get("confidence", 0.5)
            result = outcome.get("result", "fail")
            rv = RESULT_VALUES.get(result, 0.0)
            resolved.append({
                "bet": bet, "outcome": outcome,
                "result_value": rv,
                "brier": _brier(conf, result),
            })

    overconfident = sorted(
        [r for r in resolved if r["result_value"] == 0.0 and r["bet"].get("confidence", 0) >= 0.6],
        key=lambda r: -r["bet"].get("confidence", 0),
    )

    if args.json:
        print(json.dumps({
            "total": stats["total"],
            "resolved": stats["resolved"],
            "open": stats["open"],
            "hit_rate": round(stats["hit_rate"], 4),
            "mean_brier": round(stats["mean_brier"], 4),
            "overconfident_misses": [
                {"id": r["bet"]["id"], "confidence": r["bet"].get("confidence"), "brier": r["brier"]}
                for r in overconfident
            ],
        }))
        return

    n_resolved = stats["resolved"]
    successes = [r for r in resolved if r["result_value"] == 1.0]
    partials = [r for r in resolved if r["result_value"] == 0.5]
    fails = [r for r in resolved if r["result_value"] == 0.0]

    print(f"SCOREBOARD  ({now_iso()})")
    print(f"  Total bets:    {stats['total']}  (resolved: {n_resolved}, open: {stats['open']})")
    print(f"  Hit rate:      {stats['hit_rate']:.0%}  ({len(successes)} success / {len(partials)} partial / {len(fails)} fail)")
    print(f"  Mean Brier:    {stats['mean_brier']:.3f}  (0=perfect calibration, 0.25=random)")

    if overconfident:
        print(f"\n  Overconfident misses (conf ≥ 0.6, result = fail):")
        for r in overconfident:
            bet = r["bet"]
            print(f"    [{bet['id']}] conf={bet.get('confidence')} Brier={r['brier']:.3f}")
            print(f"      {bet.get('claim','')[:80]}")

    needs = stats["needs_scoring"]
    if needs:
        print(f"\n  Needs scoring (open, past horizon): {len(needs)}")
        for bet in needs:
            print(f"    [{bet['id']}] horizon={bet.get('horizon','')}  {bet.get('claim','')[:70]}")

    print(f"\n  SCOREBOARD.md written.")


def cmd_query(args):
    events = load_events()
    results = list(reversed(events))  # newest first

    if args.type:
        results = [e for e in results if e.get("type") == args.type]
    if args.kind:
        results = [e for e in results if e.get("kind") == args.kind]
    if args.text:
        needle = args.text.lower()
        results = [e for e in results if needle in json.dumps(e).lower()]

    if args.json:
        for e in results:
            print(json.dumps(e))
    else:
        for e in results:
            t = e.get("type", "?")
            eid = e.get("id", "?")
            ts = e.get("ts", "?")
            if t == "decision":
                label = e.get("title", "(untitled)")
                extra = f"  chosen: {e.get('chosen','')[:60]}"
            elif t == "artifact":
                label = f"[{e.get('kind','?')}] {e.get('ref','')}"
                extra = f"  {e.get('summary','')[:60]}"
            elif t == "lesson":
                label = e.get("what", "")[:70]
                extra = f"  apply: {e.get('apply','')[:60]}"
            elif t == "bet":
                label = e.get("claim", "")[:70]
                extra = f"  conf={e.get('confidence','?')} author={e.get('author','?')}"
            elif t == "outcome":
                label = f"→ bet/{e.get('bet_id','?')} result={e.get('result','?')}"
                extra = f"  Brier={e.get('brier','?')}"
            else:
                label = str(e)[:70]
                extra = ""
            print(f"{ts}  {t:10s}  [{eid}]  {label}")
            if extra.strip():
                print(f"  {extra.strip()}")
        print(f"\n{len(results)} record(s)")


def cmd_reindex(_args):
    reindex()
    events = load_events()
    print(f"Reindexed {len(events)} records.")


# ── arg parsing ────────────────────────────────────────────────────────────────

def build_parser():
    p = argparse.ArgumentParser(
        prog="pulse-mem",
        description="Pulse Core memory store — decisions, artifacts, lessons, bets.",
    )
    sub = p.add_subparsers(dest="command", required=True)

    # decision
    dec = sub.add_parser("decision", help="Decision operations")
    dec_sub = dec.add_subparsers(dest="subcommand", required=True)
    da = dec_sub.add_parser("add", help="Record a decision")
    da.add_argument("--title", required=True)
    da.add_argument("--context", default="")
    da.add_argument("--options", default="")
    da.add_argument("--chosen", default="")
    da.add_argument("--rationale", default="")
    da.add_argument("--reversibility", choices=["green", "yellow", "red"])
    da.add_argument("--links", default="")
    da.add_argument("--supersedes", default="")

    # artifact
    art = sub.add_parser("artifact", help="Artifact operations")
    art_sub = art.add_subparsers(dest="subcommand", required=True)
    aa = art_sub.add_parser("add", help="Register an artifact")
    aa.add_argument("--kind", required=True,
                    choices=["map", "audit", "report", "dataset", "skill", "build"])
    aa.add_argument("--ref", required=True)
    aa.add_argument("--summary", default="")
    aa.add_argument("--freshness", default="")
    aa.add_argument("--owner", default="")
    aa.add_argument("--confidence", type=float)
    aa.add_argument("--next", default="")
    aa.add_argument("--supersedes", default="")

    # lesson
    les = sub.add_parser("lesson", help="Lesson operations")
    les_sub = les.add_subparsers(dest="subcommand", required=True)
    la = les_sub.add_parser("add", help="Record a lesson")
    la.add_argument("--what", required=True)
    la.add_argument("--why", default="")
    la.add_argument("--apply", default="")
    la.add_argument("--source", default="")
    la.add_argument("--supersedes", default="")

    # bet
    bet = sub.add_parser("bet", help="Bet operations (predictions + grading)")
    bet_sub = bet.add_subparsers(dest="subcommand", required=True)

    ba = bet_sub.add_parser("add", help="Record a prediction bet")
    ba.add_argument("--claim", required=True, help="The prediction")
    ba.add_argument("--criteria", required=True, help="How we'll know success")
    ba.add_argument("--confidence", required=True, type=float, help="0.0–1.0")
    ba.add_argument("--author", default="")
    ba.add_argument("--links", default="", help="Comma-separated event IDs")
    ba.add_argument("--horizon", default="", help="Date (YYYY-MM-DD) when to check")

    bs = bet_sub.add_parser("score", help="Grade a bet against reality")
    bs.add_argument("bet_id", help="ID of the bet to score")
    bs.add_argument("--result", required=True, choices=["success", "partial", "fail"])
    bs.add_argument("--actual", required=True, help="What actually happened")
    bs.add_argument("--notes", default="", help="Lesson / why")

    bl = bet_sub.add_parser("list", help="List bets")
    bl.add_argument("--open", action="store_true", help="Show only unscored bets")

    # query
    q = sub.add_parser("query", help="Query the event log")
    q.add_argument("--type", choices=["decision", "artifact", "lesson", "bet", "outcome"])
    q.add_argument("--kind", choices=["map", "audit", "report", "dataset", "skill", "build"])
    q.add_argument("--text", help="Substring filter (case-insensitive)")
    q.add_argument("--json", action="store_true", help="Output raw JSON lines")

    # ask
    ask = sub.add_parser("ask", help="Natural-language query, BM25-ranked")
    ask.add_argument("question", help="Natural-language question")
    ask.add_argument("--top", type=int, default=8, help="Number of records to return (default 8)")
    ask.add_argument("--type", choices=["decision", "artifact", "lesson", "bet", "outcome"],
                     help="Restrict search to this record type")
    ask.add_argument("--synthesize", action="store_true",
                     help="Feed top records to claude -p for a synthesized one-paragraph answer")
    ask.add_argument("--json", action="store_true", help="Emit ranked records as JSON lines with _score")

    # reindex
    sub.add_parser("reindex", help="Regenerate markdown indexes from events.jsonl")

    # scoreboard
    sb = sub.add_parser("scoreboard", help="Metacognition view: calibration + overconfident misses")
    sb.add_argument("--json", action="store_true", help="Output raw JSON")

    return p


def main():
    parser = build_parser()
    args = parser.parse_args()

    dispatch = {
        "decision": lambda a: cmd_decision_add(a) if a.subcommand == "add" else None,
        "artifact": lambda a: cmd_artifact_add(a) if a.subcommand == "add" else None,
        "lesson": lambda a: cmd_lesson_add(a) if a.subcommand == "add" else None,
        "bet": lambda a: {
            "add": cmd_bet_add,
            "score": cmd_bet_score,
            "list": cmd_bet_list,
        }.get(a.subcommand, lambda _: parser.print_help())(a),
        "ask": cmd_ask,
        "query": cmd_query,
        "reindex": cmd_reindex,
        "scoreboard": cmd_scoreboard,
    }

    fn = dispatch.get(args.command)
    if fn:
        fn(args)
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
